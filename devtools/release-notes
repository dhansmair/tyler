#!/bin/sh
# Prints the release notes for a tag's version: its entry in CHANGELOG.md without the heading.
# Fails if the version isn't the one TylerVersion names or its entry is missing, so a tag can't
# release a build that calls itself something else. A pre-release (0.2.0-pre) names the version it
# comes before, whose entry may still be `(unreleased)`; a release's entry must be dated. Run by
# the release workflow.
#
#   devtools/release-notes <version>[-<pre-release>]
set -eu
[ $# -eq 1 ] || { echo "usage: $0 <version>[-<pre-release>]" >&2; exit 2; }
version=${1%%-*}
root=$(cd "$(dirname "$0")/.." && pwd)

current=$(sed -n 's/.*static let current = "\(.*\)".*/\1/p' "$root/Sources/TylerRuntime/TylerVersion.swift")
[ "$version" = "$current" ] || { echo "$0: the tag says $version, TylerVersion says $current" >&2; exit 1; }

if [ "$1" = "$version" ] && grep -q "^## $version (unreleased)" "$root/CHANGELOG.md"; then
  echo "$0: CHANGELOG.md still calls $version unreleased; give it the release date" >&2
  exit 1
fi
notes=$(awk -v heading="## $version " '
  index($0, heading) == 1 { found = 1; next }
  found && /^## / { exit }
  found { print }
' "$root/CHANGELOG.md")
[ -n "$(printf '%s' "$notes" | tr -d '[:space:]')" ] ||
  { echo "$0: CHANGELOG.md has no entry for $version" >&2; exit 1; }
printf '%s\n' "$notes" | sed '/./,$!d'
